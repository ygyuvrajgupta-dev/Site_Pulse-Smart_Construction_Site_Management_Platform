# SitePulse — PRODUCTION env (template, safe to commit)
# Copy to .env.production and replace all CHG_* placeholders.

# ---- Docker / PostgreSQL ----
POSTGRES_USER=sitepulse
POSTGRES_PASSWORD=CHG_SET_A_STRONG_DATABASE_PASSWORD
POSTGRES_DB=sitepulse

# ---- Application ----
NODE_ENV=production
PORT=5000
DATABASE_URL="postgresql://sitepulse:CHG_SET_A_STRONG_DATABASE_PASSWORD@postgres:5432/sitepulse?schema=public"

# ---- JWT ----
JWT_SECRET=CHG_GENERATE_STRONG_SECRET
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=CHG_GENERATE_STRONG_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS / Frontend ----
FRONTEND_URL=https://app.sitepulse.com
CORS_ORIGIN=https://app.sitepulse.com

# ---- Cookie / Proxy ----
COOKIE_SECRET=CHG_GENERATE_STRONG_SECRET
COOKIE_SECURE=true
TRUST_PROXY=true

# ---- Email ----
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=CHG_YOUR_RESEND_SMTP_USER
EMAIL_PASS=CHG_YOUR_RESEND_PASSWORD
EMAIL_FROM=noreply@yourdomain.com
LOG_LEVEL=info

# ---- AI ----
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=30000
AI_ENABLE_USAGE_TRACKING=true

# ---- Billing / Payments ----
PAYMENT_PROVIDER=both
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=USD
BILLING_DEFAULT_TAX_RATE=18
BILLING_DEFAULT_CURRENCY=USD
BILLING_AUTO_RENEW_ENABLED=true
BILLING_GRACE_PERIOD_DAYS=7
