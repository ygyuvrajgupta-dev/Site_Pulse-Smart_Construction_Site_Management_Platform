# ============================================================
# SitePulse — Frontend build + Nginx static server
# Multi-stage: build React/Vite app -> serve optimized
# static assets via Nginx (production-ready config below).
# ============================================================

# --- Stage 1: Build the Vite frontend ---
FROM node:20-alpine AS builder
WORKDIR /app

# Copy lock file + manifest for cached, deterministic installs
COPY site-pulse/SitePulse/package.json site-pulse/SitePulse/package-lock.json* ./
RUN npm ci --no-audit --no-fund

# Copy the rest of the frontend source
COPY site-pulse/SitePulse/ ./

# The frontend talks to the API through Nginx (same origin),
# so use a relative /api base URL in production.
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

# --- Stage 2: Serve via Nginx ---
FROM nginx:1.25-alpine AS runtime

# Replace the stock server block / config
RUN rm -f /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
