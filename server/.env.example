# ============================================================
# SitePulse Environment Variables
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sitepulse"

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Cookie / Proxy (set COOKIE_SECURE=true behind HTTPS + Nginx)
COOKIE_SECRET=your_cookie_secret_here
COOKIE_SECURE=false
TRUST_PROXY=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ============================================================
# AI Configuration
# ============================================================
AI_DEFAULT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google
GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-1.5-pro

# Mistral
MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-large-latest

AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=30000
AI_ENABLE_USAGE_TRACKING=true

# ============================================================
# Billing & Payments
# ============================================================

# Payment Provider (razorpay | stripe | both)
PAYMENT_PROVIDER=both

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_CURRENCY=USD

# Billing defaults
BILLING_DEFAULT_TAX_RATE=18
BILLING_DEFAULT_CURRENCY=USD
BILLING_AUTO_RENEW_ENABLED=true
BILLING_GRACE_PERIOD_DAYS=7

# ============================================================
# Email (Resend recommended)
# Resend SMTP: host smtp.resend.com, user "resend", pass = re_ API key.
# ============================================================
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=resend
EMAIL_PASS=re_YOUR_RESEND_API_KEY
EMAIL_FROM="Site Pulse <noreply@your-domain.com>"
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# ============================================================
# Cloudinary (media / file uploads)
# ============================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret