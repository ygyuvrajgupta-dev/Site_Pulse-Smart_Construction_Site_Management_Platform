// ============================================================
// Site Pulse - Multi-tenant SaaS Database Schema
// Prisma ORM | PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  DISQUALIFIED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  EMAIL_CAMPAIGN
  COLD_CALL
  PARTNER
  OTHER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
  URGENT
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum SiteStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  ARCHIVED
}

enum InventoryType {
  RAW_MATERIAL
  WORK_IN_PROGRESS
  FINISHED_GOODS
  SUPPLIES
  EQUIPMENT
}

enum ManufacturingOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
}

enum TransactionStatus {
  PENDING
  CLEARED
  RECONCILED
  DISPUTED
  CANCELLED
}

enum DocumentCategory {
  CONTRACT
  INVOICE
  REPORT
  PROPOSAL
  LEGAL
  HR
  FINANCIAL
  TECHNICAL
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  ALERT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIALING
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  VIEWED
  LOGGED_IN
  LOGGED_OUT
  EXPORTED
  IMPORTED
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
}

enum AiModelProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  MISTRAL
  CUSTOM
}

enum AiFeatureStatus {
  ACTIVE
  DISABLED
  LIMITED
}

// ============================================================
// MODELS
// ============================================================

model PlatformOwner {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  phone        String?
  avatar       String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activityLogs ActivityLog[]

  @@map("platform_owners")
}

model Company {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  email          String?
  phone          String?
  website        String?
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  logo           String?
  taxId          String?
  registrationNo String?
  isActive       Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users              User[]
  departments        Department[]
  employees          Employee[]
  leads              Lead[]
  clients            Client[]
  projects           Project[]
  sites              Site[]
  inventoryItems     InventoryItem[]
  manufacturingOrders ManufacturingOrder[]
  transactions       Transaction[]
  documents          Document[]
  subscriptions      Subscription[]
  activityLogs       ActivityLog[]
  settings           CompanySetting[]
  aiFeatures         AiFeature[]
  aiUsageLogs        AiUsageLog[]
  notifications      Notification[]
  roles              Role[]
  companyAdmins      CompanyAdmin[]
  tasks              Task[]
  milestones         Milestone[]

  @@map("companies")
}

model CompanyAdmin {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("company_admins")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  users          User[]

  @@unique([companyId, slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id              String      @id @default(cuid())
  companyId       String
  roleId          String?
  email           String      @unique
  password        String
  name            String
  phone           String?
  avatar          String?
  status          UserStatus  @default(PENDING_VERIFICATION)
  emailVerified   Boolean     @default(false)
  lastLoginAt     DateTime?
  preferences     Json?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role            Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  employee        Employee?
  assignedTasks   Task[]              @relation("TaskAssignee")
  createdTasks    Task[]              @relation("TaskCreator")
  assignedLeads       Lead[]              @relation("LeadAssignee")
  notifications       Notification[]
  userActivityLogs    ActivityLog[]       @relation("ActivityUser")
  createdActivityLogs ActivityLog[]       @relation("ActivityCreator")
  companyAdmins       CompanyAdmin[]
  documents           Document[]          @relation("DocumentUploader")
  comments            TaskComment[]
  headedDepartment    Department?
  subscriptions       Subscription[]

  @@index([companyId])
  @@index([roleId])
  @@map("users")
}

model Department {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  code        String?
  description String?
  headId      String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  head      User?      @relation(fields: [headId], references: [id], onDelete: SetNull)
  employees Employee[]

  @@unique([companyId, name])
  @@map("departments")
}

model Employee {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyId       String
  departmentId    String?
  employeeCode    String?
  jobTitle        String?
  employmentType  String?
  hireDate        DateTime?
  terminationDate DateTime?
  salary          Decimal? @db.Decimal(12, 2)
  currency        String   @default("USD")
  reportingToId   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager      Employee?   @relation("ManagerEmployee", fields: [reportingToId], references: [id])
  directReports Employee[] @relation("ManagerEmployee")

  @@index([companyId])
  @@index([departmentId])
  @@map("employees")
}

model Lead {
  id                    String     @id @default(cuid())
  companyId             String
  assignedToId          String?
  convertedToClientId   String?
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  companyName           String?
  jobTitle              String?
  source                LeadSource @default(WEBSITE)
  status                LeadStatus @default(NEW)
  score                 Int?       @default(0)
  budget                Decimal?   @db.Decimal(12, 2)
  notes                 String?
  customFields          Json?
  lastContactedAt       DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo User?       @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  clients   Client[]
  documents Document[]

  @@index([companyId])
  @@index([assignedToId])
  @@index([status])
  @@map("leads")
}

model Client {
  id              String   @id @default(cuid())
  companyId       String
  leadId          String?
  name            String
  email           String?
  phone           String?
  website         String?
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  taxId           String?
  notes           String?
  customFields    Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  projects Project[]
  sites    Site[]
  documents Document[]

  @@index([companyId])
  @@map("clients")
}

model Project {
  id              String        @id @default(cuid())
  companyId       String
  clientId        String?
  name            String
  code            String?
  description     String?
  status          ProjectStatus @default(PLANNING)
  priority        TaskPriority  @default(MEDIUM)
  startDate       DateTime?
  endDate         DateTime?
  budget          Decimal?      @db.Decimal(14, 2)
  actualCost      Decimal?      @default(0) @db.Decimal(14, 2)
  currency        String        @default("USD")
  progress        Int           @default(0)
  notes           String?
  customFields    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sites   Site[]
  tasks   Task[]
  milestones Milestone[]

  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@map("projects")
}

model Site {
  id          String     @id @default(cuid())
  companyId   String
  clientId    String?
  projectId   String?
  name        String
  code        String?
  url         String?
  type        String?
  status      SiteStatus @default(ACTIVE)
  description String?
  address     String?
  city        String?
  state       String?
  country     String?
  latitude    Float?
  longitude   Float?
  settings    Json?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@map("sites")
}

model Task {
  id              String       @id @default(cuid())
  companyId       String
  projectId       String?
  parentId        String?
  creatorId       String?
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  assigneeId      String?
  dueDate         DateTime?
  estimatedHours  Float?
  actualHours     Float?
  startDate       DateTime?
  completedAt     DateTime?
  sortOrder       Int          @default(0)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      Task?        @relation("TaskSubtasks", fields: [parentId], references: [id])
  subtasks    Task[]       @relation("TaskSubtasks")
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User?        @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  comments    TaskComment[]

  @@index([companyId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model Milestone {
  id          String          @id @default(cuid())
  companyId   String
  projectId   String
  name        String
  description String?
  status      MilestoneStatus @default(NOT_STARTED)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("milestones")
}

model InventoryItem {
  id              String        @id @default(cuid())
  companyId       String
  name            String
  sku             String?
  type            InventoryType @default(RAW_MATERIAL)
  description     String?
  quantity        Int           @default(0)
  unit            String?
  unitPrice       Decimal?      @db.Decimal(12, 2)
  reorderPoint    Int?
  location        String?
  supplier        String?
  currency        String        @default("USD")
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([sku])
  @@map("inventory_items")
}

model ManufacturingOrder {
  id                String                  @id @default(cuid())
  companyId         String
  orderNo           String                  @unique
  productName       String
  description       String?
  quantity          Int
  producedQuantity  Int                     @default(0)
  status            ManufacturingOrderStatus @default(DRAFT)
  startDate         DateTime?
  endDate           DateTime?
  dueDate           DateTime?
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("manufacturing_orders")
}

model Transaction {
  id              String          @id @default(cuid())
  companyId       String
  type            TransactionType @default(EXPENSE)
  status          TransactionStatus @default(PENDING)
  amount          Decimal         @db.Decimal(14, 2)
  currency        String          @default("USD")
  description     String?
  category        String?
  referenceNo     String?
  transactionDate DateTime        @default(now())
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([type])
  @@index([transactionDate])
  @@map("transactions")
}

model Document {
  id          String           @id @default(cuid())
  companyId   String
  uploaderId  String
  leadId      String?
  clientId    String?
  category    DocumentCategory @default(OTHER)
  name        String
  fileName    String
  fileSize    Int
  mimeType    String
  url         String
  description String?
  tags        String[]
  isArchived  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploader User     @relation("DocumentUploader", fields: [uploaderId], references: [id])
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([category])
  @@map("documents")
}

model Notification {
  id          String           @id @default(cuid())
  companyId   String
  userId      String
  type        NotificationType @default(INFO)
  channel     NotificationChannel @default(IN_APP)
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([companyId])
  @@map("notifications")
}

model Plan {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  description String?
  price       Decimal         @db.Decimal(10, 2)
  currency    String          @default("USD")
  interval    BillingInterval @default(MONTHLY)
  trialDays   Int             @default(14)
  features    Json
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                    String            @id @default(cuid())
  companyId             String
  planId                String
  userId                String
  status                SubscriptionStatus @default(TRIALING)
  startDate             DateTime          @default(now())
  endDate               DateTime?
  trialEndsAt           DateTime?
  canceledAt            DateTime?
  autoRenew             Boolean            @default(true)
  stripeSubscriptionId  String?            @unique
  stripeCustomerId      String?
  metadata              Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("subscriptions")
}

model ActivityLog {
  id             String        @id @default(cuid())
  companyId      String
  userId         String?
  creatorId      String?
  platformOwnerId String?
  action         ActivityAction
  entity         String
  entityId       String
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  company       Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User?            @relation("ActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  creator       User?            @relation("ActivityCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  platformOwner PlatformOwner?   @relation(fields: [platformOwnerId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model CompanySetting {
  id        String   @id @default(cuid())
  companyId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("company_settings")
}

model AiFeature {
  id             String           @id @default(cuid())
  companyId      String
  name           String
  provider       AiModelProvider  @default(OPENAI)
  modelName      String?
  apiKey         String?
  status         AiFeatureStatus  @default(ACTIVE)
  monthlyLimit   Int?
  usedThisMonth  Int              @default(0)
  settings       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  usageLogs AiUsageLog[]

  @@unique([companyId, name])
  @@map("ai_features")
}

model AiUsageLog {
  id        String   @id @default(cuid())
  companyId String
  featureId String?
  userId    String?
  modelName String
  prompt    String?
  response  String?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  duration  Int?
  cost      Decimal? @db.Decimal(10, 6)
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature  AiFeature? @relation(fields: [featureId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}